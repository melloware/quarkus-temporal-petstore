# This is the root of the project, stop looking for lombok.config in parent directories
config.stopBubbling = true

# Quarkus ships Jackson 2 (com.fasterxml.jackson), so @Jacksonized only needs the Jackson 2 annotations.
# Without this Lombok warns that both Jackson 2 and Jackson 3 are on the classpath.
lombok.jacksonized.jacksonVersion += 2
